# คัดลอกเป็น .env สำหรับรันในเครื่อง (ห้าม commit ไฟล์ .env)
PORT=8080

# Supabase > Project Settings > Database > Connection string > "Session pooler" (URI)
# ใช้ Session pooler เพราะ Render เชื่อม IPv6 ของ Direct connection ไม่ได้
DATABASE_URL=postgresql://postgres.xxxx:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# สุ่มค่ายาว ๆ อย่างน้อย 32 ตัวอักษร: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me

# โดเมนของ Frontend คั่นหลายโดเมนด้วย comma (ไม่ต้องมี / ท้าย)
ALLOWED_ORIGINS=http://localhost:3000,https://your-site.vercel.app

# บัญชี Admin ที่ระบบสร้างให้อัตโนมัติตอนเริ่ม server
ADMIN_EMAIL=admin@pawhome.test
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=PawHome Admin
